<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar Lectura</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">IoT - Lecturas</a>
      <a href="/" class="btn btn-outline-light btn-sm">Volver</a>
    </div>
  </nav>
  <div class="container">
    <div class="card shadow-sm">
      <div class="card-header"><h4 class="mb-0">Editar Lectura</h4></div>
      <div class="card-body">
        <% if (errors.length > 0) { %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% errors.forEach(function(e) { %>
                <li><%= e.msg %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>
        <form method="POST" action="/edit/<%= lectura._id %>">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Sensor *</label>
              <input name="sensor" class="form-control" value="<%= lectura.sensor %>" required>
            </div>
            <div class="col-md-3">
              <label class="form-label">Valor *</label>
              <input name="valor" type="number" step="any" class="form-control" value="<%= lectura.valor %>" required>
            </div>
            <div class="col-md-3">
              <label class="form-label">NodeRED *</label>
              <select name="nodered" class="form-select" required>
                <option value="true" <%= lectura.nodered ? 'selected' : '' %>>Sí</option>
                <option value="false" <%= !lectura.nodered ? 'selected' : '' %>>No</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Ubicación *</label>
              <input name="ubicacion" class="form-control" value="<%= lectura.ubicacion %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Fecha/Hora *</label>
              <input name="fecha_hora" type="datetime-local" class="form-control" value="<%= new Date(lectura.fecha_hora).toISOString().substring(0,16) %>" required>
            </div>
          </div>
          <div class="mt-4">
            <button class="btn btn-primary">Actualizar</button>
            <a href="/" class="btn btn-secondary">Cancelar</a>
          </div>
        </form>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
