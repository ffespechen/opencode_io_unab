<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IoT - Lecturas</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
  <nav class="navbar navbar-dark bg-dark mb-4">
    <div class="container">
      <a class="navbar-brand" href="/">IoT - Lecturas <span class="text-muted small">esp32_lecturas</span></a>
      <a href="/create" class="btn btn-outline-light btn-sm">+ Nueva Lectura</a>
    </div>
  </nav>
  <div class="container">
    <h2 class="mb-3">Listado de Lecturas</h2>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <div class="table-responsive">
      <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
          <tr>
            <th>Sensor</th>
            <th>Valor</th>
            <th>Ubicación</th>
            <th>Fecha/Hora</th>
            <th>NodeRED</th>
            <th style="width:160px">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (lecturas.length === 0) { %>
            <tr><td colspan="6" class="text-center text-muted">No hay lecturas registradas</td></tr>
          <% } %>
          <% lecturas.forEach(function(l) { %>
            <tr>
              <td><%= l.sensor %></td>
              <td><%= l.valor %></td>
              <td><%= l.ubicacion %></td>
              <td><%= new Date(l.fecha_hora).toLocaleString("es-CL") %></td>
              <td><%= l.nodered ? "Sí" : "No" %></td>
              <td>
                <a href="/edit/<%= l._id %>" class="btn btn-sm btn-warning">Editar</a>
                <form method="POST" action="/delete/<%= l._id %>" style="display:inline">
                  <button class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar esta lectura?')">Eliminar</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
